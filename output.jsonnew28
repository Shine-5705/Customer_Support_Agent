at]gov[dot]in\n03712258534\n03712258508,\n258836\nDESIDOC\ndirector[dot]desidoc[at]gov[dot]in\n01123813465,\n23819151,\n23813591\n01123812252 ,\n23986680\nDTRL\ndirector[dot]dtrl[at]gov[dot]in\n01123812494\n23811599,\n24648566\nLRDE\ndirector[dot]lrde[at]gov[dot]in\n918025242916\n918025243873,\n918025243816\nGTRE\ndirector[dot]gtre[at]gov[dot]in\n08025241507\n25240698 ,\n25241892\nHEMRL\ndirector[dot]hemrl[at]gov[dot]in\n02025869316\n02025869303\nDIAT(DU)\ndirector[dot]diat[at]gov[dot]in\n24389411,\n24389509\n24389426,\n24389427,\n24389428\nINMAS\ndirector[dot]inmas[at]gov[dot]in\n01123919509\n23942418,\n23981910\nISSA\ndirector[dot]issa[at]gov[dot]in\n01123819033\n23812639\nITM\ndirector[dot]itm[at]gov[dot]in\n01352632279\n01352632267,\n2632814\nITR\ndirector[dot]itr[at]gov[dot]in\n06782272072\n272033,\n272304\nIRDE\ndirector[dot]irde[at]gov[dot]in\n+91-135-2787128,\n2787161\n+91-135-2787169,\n2787126\nLASTEC\ndirector[dot]lastec[at]gov[dot]in\n01123811319\n01123817625\n01123815180\nMTRDC\ndirector[dot]mtrdc[at]gov[dot]in\n08028381750,\n28386809,\n28386804\n28386801,\n23450099\nNMRL\ndirector[dot]nmrl[at]gov[dot]in\n02512623004\n02512623037\nNPOL\ndirector[dot]npol[at]gov[dot]in\n04842424858,\n2423931\n2424878,\n2422004\nNSTL\ndirector[dot]nstl[at]gov[dot]in\n08322530800\n2530801,\n2541636\nPXE\ndirector[dot]pxe[at]gov[dot]in\n06782272126\n06782272045\n272122\nRAC\ndirector[dot]recruitment[dot]\ndrdo[dot]in\n01123812690\n01123817833,\n01123810314\nRCMA\ndirector[dot]rcma[at]gov[dot]in\n05222350022\nRCI\ndirector[dot]rci[at]gov[dot]in\n04024306086\n24306001 ,\n27567419\nR&DE\ndirector[dot]rde[at]gov[dot]in\n020 27150783,\n27150330,\n27150437\nSAG\ndirector[dot]sag[at]gov[dot]in\n011 23812683,\n23818798\n23819828 ,\n23963939\nSASE\ndirector[dot]sase[at]gov[dot]in\n01722699802,\n2699970\n2699801,\n2701374\nSSPL\ndirector[dot]sspl[at]gov[dot]in\n01123913609,\n23984285,\n23921652\n23818041 ,\n27521828\nTBRL\ndirector[dot]tbrl[at]gov[dot]in\n0172 - 2657506\n01733- 253495\n2657659,\n2657674,\n2651723\nVRDE\ndirector[dot]vrde[at]gov[dot]in\n02412548410,\n2548449\n2548400 ,\n2548411\nश्रेणी बी टेक्नोलॉजीज (दोहरे उपयोग / वाणिज्यिक प्रौद्योगिकी)\nश्रेणी 'बी' प्रौद्योगिकियां दोहरे उपयोग वाली प्रौद्योगिकियां हैं (स्पिन-ऑफ प्रौद्योगिकियों सहित) जो सुरक्षा के प्रति संवेदनशील नहीं हैं और रक्षा अनुप्रयोगों से परे वाणिज्यिक क्षमता रखती हैं। कैट 'बी' प्रौद्योगिकियों का टीओटी भारत और/या विदेशों में उपयुक्त वाणिज्यिक बाजारों में निर्माण और बिक्री के लिए दिया जाता है।\nश्रेणी बी टेक्नोलॉजीज टीओटी के लिए तैयार\nDRDO\nप्रौद्योगिकी\nएलएबी\nटीओटी लाइसेंस की संख्या\nबोली शुरू होने की तारीख\nबोली बंद करने की तिथि\nटिप्पणियां\nजी ए एन एच ई एम टी आधारित एम एम आई सी प्रौद्योगिकी\n71 के बी\nएस एस पी एल\n05\n08/05/2025\n21/06/2025\nलंबे समय तक चलने वाली मच्छरदानी के लिए बहुक्रियाशील कीटनाशक द्वि-घटक रेशा\n490 के.बी.\nडी.एम.एस.आर.डी.ई.\n10\n02/04/2025\n17/05/2025\nथर्मोप्लास्टिक एस्टर पॉलीयूरेथेन (इंस्टेन): प्रक्रिया प्रौद्योगिकी\n41 के.बी.\nएच ई एम आर एल\n03\n02/04/2025\n15/05/2025\nइन्फ्रारेड ऑप्टिक्स के लिए जर्मेनियम एकल क्रिस्टल विकास\n40 के.बी.\nएस एस पी एल\n05\n12/03/2025\n25/04/2025\nआर एफ एस ओ सी आधारित क्वांटम कंप्यूटर प्रोसेसर नियंत्रक (आर सी क्यू सी पी)\n55 के.बी.\nडी वाई एस एल-क्यू टी\n04\n27/02/2025\n02/05/2025\nठंडी स्थिति में आश्रय स्थल को गर्म करने के लिए सौर तापीय प्रौद्योगिकी आधारित प्रणाली\n56 KB\nDIHAR\n04\n11/02/2025\n28/03/2025\nउच्च ऊंचाई पर ताजा भोजन के भंडारण के लिए निष्क्रिय भूमिगत संरचना का डिजाइन\n47 के.बी.\nडी आई एच ए आर\n03\n05/02/2025\n20/03/2025\nउच्च प्रदर्शन बायोडाइजेस्टर (एचपीबीडी) प्रौद्योगिकी\n47 के.बी.\nडी आर डी ई\n03\n18/12/2024\n31/01/2025\nसंघनित एरोसोल आधारित अग्नि शमन प्रणाली (सी ए एफ ई एस)\n107 के.बी.\nसी एफ ई ई एस\n10\n25/11/2024\n08/01/2025\nउच्च तापमान प्रतिरोधी फ़ेथलोनिट्राइल रेजिन\n46 के.बी.\nडी.एम.एस.आर.डी.ई.\n10\n18/07/2024\n31/08/2024\nब्रॉडबैंड टेराहर्ट्ज़ अनुप्रयोगों के लिए जेड एन टी ई सिंगल क्रिस्टल ग्रोथ\n311 के बी\nएस एस पी एल\n05\n05/06/2024\n19/07/2024\nजंगली भूमि अग्निशमन सूट\n433 के. बी.\nसी एफ ई ई एस\n08\n20/05/2023\n03/07/2024\nनाइट्राइल रबर कंपाउंड (डी आर एल एम-ए 4)\n30 के.बी.\nडी.एम.एस.आर.डी.ई.\n05\n10/04/2024\n04/10/2024\nतिथि 04/10/2024 तक बढ़ाई गई\nफ्लोरोकार्बन आधारित रबर यौगिक (डी एम एस-एफ ई-75)\n31 के.बी.\nडी.एम.एस.आर.डी.ई.\n05\n10/04/2024\n04/10/2024\nतिथि 04/10/2024 तक बढ़ाई गई\nएफ ई आधारित बल्क मेटालिक ग्लास (बीएमजी) कोटिंग्स (एन एम आर-एफ ई बी एम जी)\n351 के बी\nएन एम आर एल\n6\n05/03/2024\n05/06/2024\nस्वदेशी स्थिरीकरण एवं परिशोधन सामग्री (पीएस-I)\n361 के.बी.\nसीफीस\n5\n02/02/2024\n28/07/2024\nस्वदेशी स्थिरीकरण एवं परिशोधन सामग्री (पी एस-आई)\n361 के.बी.\nसी एफ ई ई एस\n5\n02/02/2024\n17/03/2024\nग्लास सब्सट्रेट पर सीवीडी विधि द्वारा विकसित CuS पतली फिल्मों का उपयोग करके डाई का फोटोकैटलिटिक डिग्रेडेशन\n455 के.बी.\nडी एम एस आर डी ई\n5\n23/01/2024\n02/10/2024\nप्रभाव प्रतिरोधी अनुप्रयोगों के लिए शीयर थिकनिंग जेल आधारित नैनोकम्पोजिट की प्रसंस्करण और सामग्री प्रौद्योगिकियां\n526 के.बी.\nडी एम एस आर डी ई\n10\n23/01/2024\n07/03/2024\nसिलिकॉन पतली फिल्मों के जमाव के लिए साइक्लो ऑर्गनोपेंटासिलेन का थोक उत्पादन\n452 के.बी.\nडी एम एस आर डी ई\n10\n23/01/2024\n02/10/2024\nसिलिकॉन कार्बाइड सतह को समतल करने के लिए रासायनिक यांत्रिक पॉलिशिंग एजेंट सेप्सल-86\n450 के.बी.\nडी एम एस आर डी ई\n10\n23/01/2024\n02/10/2024\nबस में रहने वाले कम्पार्टमेंट फायर प्रोटेक्शन सिस्टम के लिए वाटर मिस्ट सिस्टम\n29 केबी (अंग्रेज़ी)\nसीफीस\n15*\n07/12/2023\n20/01/2024\nअतिरिक्त लाइसेंस के लिए बोलियां आमंत्रित की जाती हैं। यह उक्त प्रौद्योगिकी के लिए पहले जारी किए गए 05 लाइसेंसों के अतिरिक्त है।\nहाई प्रेशर वॉटर मिस्ट फायर सप्रेस सिस्टम (एच पी डब्ल्यू एम एफ एस एस)\n119 केबी (अंग्रेज़ी)\nसीफीस\n10\n04/07/2023\n24/07/2023\nउच्च तापमान पॉलिमर इलेक्ट्रोलाइट नैनोकोम्पोसिट मेम्ब्रेन (NMR-HTPEMT) प्रौद्योगिकी\n130 केबी(अंग्रेज़ी)\nएन एम आर एल\n04\n11/05/2023\n25/06/2023\nउच्च तापमान क्षरण प्रतिरोधी सम्मिश्र\n10 केबी(अंग्रेज़ी)\nडी एम आर एल\n05\n17/04/2023\n28/05/2023\nसिलिकॉन कार्बाइड सिंगल क्रिस्टल बल्क ग्रोथ एंड वेफर फैब्रिकेशन प्रोसेस टेक्नोलॉजी फॉर 4” डायमीटर सबस्ट्रेट्स\n179 केबी (अंग्रेज